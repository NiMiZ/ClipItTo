<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Source of truth for the daemon's session-bus API.
     Bus name: io.github.nimiz.ClipItTo   Object path: /io/github/nimiz/ClipItTo -->
<node>
  <interface name="io.github.nimiz.ClipItTo">
    <!-- Show the popup if hidden, hide it if shown. The token is an xdg-activation token
         (XDG_ACTIVATION_TOKEN) or X11 startup id; empty when none is available. -->
    <method name="Toggle">
      <arg name="activation_token" type="s" direction="in"/>
    </method>
    <method name="Show">
      <arg name="activation_token" type="s" direction="in"/>
    </method>
    <method name="Hide"/>

    <!-- Called by capture helpers (the GNOME Shell extension) for each clipboard change. -->
    <method name="Ingest">
      <arg name="text" type="s" direction="in"/>
      <arg name="mime_types" type="as" direction="in"/>
    </method>

    <!-- Asked by a capture helper before it reads a copy marked by a password manager: true
         when password copies are kept (a master password is set), so the text is sent with
         its markers and sealed by the daemon; otherwise the helper never reads it. Ingest calls
         with markers are accepted from GNOME Shell only. -->
    <method name="WantsPasswords">
      <arg name="wanted" type="b" direction="out"/>
    </method>

    <!-- Ingest for a text copy that also has an HTML version (from the GNOME extension). The daemon keeps the HTML
         only if it has formatting and keep_formatting is on. Refused for a marked (password) copy. -->
    <method name="IngestRich">
      <arg name="text" type="s" direction="in"/>
      <arg name="html" type="s" direction="in"/>
      <arg name="mime_types" type="as" direction="in"/>
    </method>

    <!-- The same for a copied picture with no plain text: its bytes as the source offered
         them (PNG preferred) and that MIME type. The daemon decodes, re-encodes and stores it. -->
    <method name="IngestImage">
      <arg name="data" type="ay" direction="in"/>
      <arg name="mime_type" type="s" direction="in"/>
      <arg name="mime_types" type="as" direction="in"/>
    </method>

    <method name="ReloadConfig"/>

    <!-- Locks the password copies now (the CLI's lock option). -->
    <method name="LockPasswords"/>

    <!-- Runs one sync through the shared folder now (the CLI's sync option); does nothing when sync is off. -->
    <method name="SyncNow"/>

    <!-- Exits the daemon. Under systemd, prefer stopping the clipitto.service user unit. -->
    <method name="Quit"/>

    <method name="Status">
      <arg name="status" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>

    <signal name="VisibilityChanged">
      <arg name="visible" type="b"/>
    </signal>
  </interface>
</node>
